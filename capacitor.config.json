{
  "appId": "com.myzanetty.app",
  "appName": "ميزانيتي",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#f4f6f8"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#0F766E"
    }
  }
}